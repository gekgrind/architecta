NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_APP_URL=https://entrepreneuria.io
NEXT_PUBLIC_ENTREPRENEURIA_APP_URL=https://entrepreneuria.io
# Legacy fallbacks (safe to keep aligned with NEXT_PUBLIC_ENTREPRENEURIA_APP_URL)
NEXT_PUBLIC_AUTH_APP_URL=https://entrepreneuria.io
NEXT_PUBLIC_SITE_URL=https://entrepreneuria.io
NEXT_PUBLIC_ENTREPRENEURIA_COOKIE_DOMAIN=.entrepreneuria.io
NEXT_PUBLIC_ARCHITECTA_APP_URL=https://architecta.entrepreneuria.io
NEXT_PUBLIC_PROSPRA_APP_URL=https://prospra.entrepreneuria.io
NEXT_PUBLIC_DIRECTORIUM_APP_URL=https://directorium.entrepreneuria.io
NEXT_PUBLIC_SYNCERI_APP_URL=https://synceri.entrepreneuria.io

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Social publishing (Phase 8)
# 32+ char random secret used to encrypt stored OAuth tokens at rest.
PLATFORM_TOKEN_ENC_KEY=your_long_random_token_encryption_secret
# Shared secret the scheduled publish worker must present (Authorization: Bearer ...).
CRON_SECRET=your_long_random_cron_secret
# LinkedIn developer app (needs the "Sign In with LinkedIn (OIDC)" + "Share on LinkedIn" products).
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Meta app for Instagram/Facebook. Needs a Facebook Page (and, for Instagram, a
# Business/Creator IG account linked to that Page). Redirect URIs to register:
#   https://architecta.entrepreneuria.io/api/connections/facebook/callback
#   https://architecta.entrepreneuria.io/api/connections/instagram/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Threads app (Meta dashboard → Threads use case). Redirect URI to register:
#   https://architecta.entrepreneuria.io/api/connections/threads/callback
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
# X (Twitter) developer app — OAuth 2.0 with PKCE, "Read and write" permissions.
# Redirect URI to register: https://architecta.entrepreneuria.io/api/connections/x/callback
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
# Pinterest developer app (developers.pinterest.com). Redirect URI to register:
#   https://architecta.entrepreneuria.io/api/connections/pinterest/callback
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
# YouTube reuses GOOGLE_CLIENT_ID/SECRET above — just enable the YouTube Data
# API v3 on that Google Cloud project and add the youtube.upload +
# youtube.readonly scopes to the OAuth consent screen. Redirect URI:
#   https://architecta.entrepreneuria.io/api/connections/youtube/callback
# TikTok developer app (developers.tiktok.com). video.publish requires app
# audit before posts are publicly visible. Redirect URI to register:
#   https://architecta.entrepreneuria.io/api/connections/tiktok/callback
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
