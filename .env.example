# Social publishing (Phase 8)
# 32+ char random secret used to encrypt stored OAuth tokens at rest.
PLATFORM_TOKEN_ENC_KEY=your_long_random_token_encryption_secret
# Shared secret the scheduled publish worker must present (Authorization: Bearer ...).
CRON_SECRET=your_long_random_cron_secret
# LinkedIn developer app (needs the "Sign In with LinkedIn (OIDC)" + "Share on LinkedIn" products).
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Meta app for Instagram/Facebook (stubbed until the app + Business account + review are ready).
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
